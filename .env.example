# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Telegram instant order notifications
# Create a bot via @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: Email order notifications via Resend (https://resend.com)
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL=""
RESEND_FROM_EMAIL="orders@resend.dev"

# Optional: Generic Webhook URL (Make / Zapier / WhatsApp Cloud API bridge)
ORDER_WEBHOOK_URL=""
